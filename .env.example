# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ENV=prod
LOG_LEVEL=INFO
LOG_FORMAT=json
# Public HTTPS base URL of the deployed service, no trailing slash.
PUBLIC_BASE_URL=https://your-service.example.com
ALLOWED_HOSTS=your-service.example.com

# ---------------------------------------------------------------------------
# Postgres (Supabase pooler host; the direct host is IPv6-only on some nets)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password-url-encoded>@aws-1-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2, private bucket)
# ---------------------------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# ---------------------------------------------------------------------------
# YouTube Data API v3 (metadata + discovery ONLY; never unlocks captions)
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_QUOTA_RESERVE_UNITS=500

# ---------------------------------------------------------------------------
# Transcripts — first configured provider in order wins.
# Providers: apify, ytdlp, yta, supadata.
#   apify    : Apify token (console.apify.com). $0 plan = $5/mo usage, no card.
#              Actor supreme_coder/youtube-transcript-scraper, ~$0.70/1k.
#   ytdlp    : no key. Subtitle-only; often HTTP 429 from cloud IPs.
#   yta      : no key. youtube-transcript-api; frequently IP-blocked.
#   supadata : SUPADATA_API_KEY. Free tier 100 credits/month.
# ---------------------------------------------------------------------------
TRANSCRIPT_PROVIDER_ORDER=yta
TRANSCRIPT_LANGUAGES=en
TRANSCRIPT_MAX_ATTEMPTS=6
SUPADATA_API_KEY=
APIFY_API_TOKEN=

# ---------------------------------------------------------------------------
# Embeddings (local ONNX via fastembed; no external key, no training)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VERSION=v1
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Chunking / processing
# ---------------------------------------------------------------------------
CHUNK_TARGET_CHARS=2600
CHUNK_OVERLAP_CHARS=350
CHUNK_MAX_CHARS=4000
PROCESSING_VERSION=1
SYNC_INTERVAL_MINUTES=360
SYNC_MAX_VIDEOS_PER_RUN=200
WORKER_POLL_SECONDS=5
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=6

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_RESEARCH_PER_HOUR=20
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
MAX_TRANSCRIPT_PAGE_SEGMENTS=300
FULL_TRANSCRIPT_MAX_CHARS=60000

# ---------------------------------------------------------------------------
# Optional research model (leave empty for extractive-only research)
# ---------------------------------------------------------------------------
RESEARCH_MODEL_PROVIDER=
RESEARCH_MODEL_NAME=
RESEARCH_API_KEY=
RESEARCH_BASE_URL=
RESEARCH_MAX_TRANSCRIPTS=500
RESEARCH_MAX_TOKENS_PER_JOB=2000000

# ---------------------------------------------------------------------------
# Bootstrap (first run only; create real scoped keys through /admin/keys)
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_TOKEN=
